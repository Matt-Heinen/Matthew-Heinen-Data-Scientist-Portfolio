chicago_vice <- chicago_vice[-1, ]
# Rename the columns
colnames(chicago_vice) <- c("date", "kia/hyundai", "All", "Percent")
# Preview
head(chicago_vice)
# add other thefts finding difference between all and kia thefts
chicago_vice$OtherThefts <- as.numeric(chicago_vice$All) - as.numeric(chicago_vice$`kia/hyundai`)
# Format variables as numeric
chicago_vice$`kia/hyundai` <- as.numeric(chicago_vice$`kia/hyundai`)
chicago_vice$All <- as.numeric(chicago_vice$All)
#Preview
head(chicago_vice)
#Reshape from wide to long format in order to build stacked area graph
# use pivot_longer like with the milwaukee example.
chicago_long <- chicago_vice %>%
select(date, `kia/hyundai`, OtherThefts) %>%
rename(`Kia/Hyundai Thefts` = `kia/hyundai`,
`Other Thefts` = OtherThefts) %>%
pivot_longer(cols = -date, names_to = "TheftType", values_to = "Count")
# Build Stacked area chart for Chicago vehicle theft
# Libraries
library(ggplot2)
ggplot(chicago_long, aes(x = date, y = Count, fill = TheftType)) +
geom_area(alpha = 0.8) +
scale_fill_manual(values = c("Kia/Hyundai Thefts" = "red",
"Other Thefts" = "gray")) +
labs(title = "Chicago Vehicle Thefts",
x = "Date",
y = "Number of Thefts",
fill = "Theft Type") +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1),
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
plot.title = element_text(hjust = 0.5, face = "bold") # Center Title
)
