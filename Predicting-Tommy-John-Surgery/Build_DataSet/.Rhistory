# install packages
install.packages("maps")
# Load libraries
library(ggplot2)
library(maps)
# Create heatmap with a red gradient fill
ggplot(car_theft_map, aes(x = longitude, y = latitude, fill = percentChange2019to2022)) +
geom_tile() +
scale_fill_gradient(low = "white", high = "red", name = "% Change") +
labs(title = "Percent Change Heatmap by Location (Red Gradient)",
x = "Longitude",
y = "Latitude") +
theme_minimal()
# Get U.S. map data
us_map <- map_data("state")
# Plot the heatmap
ggplot() +
# Base USA map
geom_polygon(data = us_map, aes(x = long, y = lat, group = group),
fill = "gray90", color = "white") +
# Heat points (use geom_tile for true tile heatmap, but scatter here is more readable)
geom_point(data = car_theft_map, aes(x = longitude, y = latitude, color = percentChange2019to2022),
size = 5) +
scale_color_gradient(low = "white", high = "red", name = "% Change") +
coord_fixed(1.3) +
labs(title = "Car Theft Percent Increase by City 2019 - 2022",
x = "Longitude",
y = "Latitude") +
theme_minimal()+ theme(panel.grid.major = element_blank(),  # Remove major gridlines
panel.grid.minor = element_blank(),  # Remove minor gridlines
panel.border = element_blank(),      # Optional: remove border
axis.line = element_blank(),# Optional: remove axis lines
axis.text = element_blank(),         # Remove axis tick labels
axis.ticks = element_blank(),        # Remove axis ticks
axis.title = element_blank(),        # Remove axis titles
plot.title = element_text(hjust = 0.5, face = "bold")  # Center title
)
# Format date column
# Load Libraries
library(dplyr)
library(tidyr)
library(lubridate)
# Combine year and month into a proper date
kia_mil <- kia_mil %>%
mutate(date = ymd(paste(year, month, "01", sep = "-")))
# Move from wide format to long format to build chart later
# Load Library
library(tidyr)
library(dplyr)
# Reshape to longer format for ggplot (remove seperate columns and make only count a column)
df_long <- kia_mil %>%
pivot_longer(cols = c(countKiaHyundaiThefts, countOtherThefts),
names_to = "TheftType",
values_to = "Count") %>%
# Rename values for the legend
mutate(TheftType = recode(TheftType,
"countKiaHyundaiThefts" = "Kia/Hyundai Thefts",
"countOtherThefts" = "Other Thefts"))
# Build stacked area chart of milwaukee vehicle theft.
# Load Libraries
library(ggplot2)
# Build stacked area chart showing proportion of kias Hyundai theft
ggplot(df_long, aes(x = date, y = Count, fill = TheftType)) +
geom_area(alpha = 0.8) +
scale_fill_manual(values = c("Kia/Hyundai Thefts" = "red",
"Other Thefts" = "gray")) +
labs(title = "Milwaukee Vehicle Thefts",
x = "Date",
y = "Number of Thefts",
fill = "Theft Type") +  # Legend title
theme_minimal()+
theme(
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
plot.title = element_text(hjust = 0.5, face = "bold") # Center Title
)
