# Filter 2020 forward
mil_filtered <- df_long %>% filter(date >= as.Date("2020-01-01"))
# Summarize thefts by type
mil_summary <- mil_filtered %>%
group_by(TheftType) %>%
summarise(Total = sum(Count, na.rm = TRUE)) %>%
mutate(Percent = Total / sum(Total) * 100,
Label = paste0(TheftType, ": ", round(Percent, 1), "%"))
# Pie chart with percentages
ggplot(mil_summary, aes(x = "", y = Total, fill = TheftType)) +
geom_col(width = 1, color = "white") +
coord_polar(theta = "y") +
geom_text(aes(label = Label), position = position_stack(vjust = 0.55)) +
scale_fill_manual(values = c("Kia/Hyundai Thefts" = "red",
"Other Thefts" = "gray")) +
labs(title = "Milwaukee Vehicle Thefts (2020–Present)",
fill = "Theft Type") +
theme_void() +
# Remove legend
theme(legend.position = "none")
