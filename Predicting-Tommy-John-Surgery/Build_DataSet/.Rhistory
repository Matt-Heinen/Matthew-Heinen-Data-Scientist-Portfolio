group_by(city) %>%
summarise(
KiaHyundaiThefts = sum(countKiaHyundaiThefts, na.rm = TRUE),
OtherThefts = sum(countOtherThefts, na.rm = TRUE)  # Assuming other thefts = all - kia
) %>%
pivot_longer(cols = c(KiaHyundaiThefts, OtherThefts), names_to = "TheftType", values_to = "Count")
# Plot the stacked bar graph with categorical data
ggplot(kia_stacked_data, aes(x = reorder(city, -Count), y = Count, fill = TheftType)) +
geom_bar(stat = "identity") +
# Colors for consistency
scale_fill_manual(values = c("KiaHyundaiThefts" = "red", "OtherThefts" = "grey"))+
labs(title = "Kia/Hyundai Other Major Cities (2019-2022)",
x = "City",
y = "Number of Thefts",
fill = "Type of Theft") +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1),
# Adjust gridlines and axis
panel.grid.major = element_blank(),
panel.grid.minor = element_blank(),
axis.line = element_line(),
axis.ticks = element_line(),
plot.title = element_text(hjust = 0.5, face = "bold") # Center Title
)
